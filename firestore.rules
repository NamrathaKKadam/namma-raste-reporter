rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Report Validation ---
    function isValidReport(data) {
      return data.keys().hasAll(['ticketId', 'issueType', 'imageUrl', 'latitude', 'longitude', 'userId', 'status', 'timestamp'])
        && data.ticketId is string && data.ticketId.size() <= 20
        && data.issueType in ['POTHOLE', 'BROKEN_STREETLIGHT']
        && data.imageUrl is string && data.imageUrl.size() <= 1000
        && data.latitude is number
        && data.longitude is number
        && data.userId == request.auth.uid
        && data.status == 'SUBMITTED'
        && data.timestamp == request.time;
    }

    // --- Collection Routes ---
    match /reports/{reportId} {
      // Users can only view their own reports or search by ticketId
      allow get: if isSignedIn(); 
      
      // Enforce list security: only owner can list their reports
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() 
        && isValidId(reportId)
        && isValidReport(incoming());

      allow update: if false; // Status updates normally should be done by admin/system
      
      allow delete: if false;
    }
  }
}
